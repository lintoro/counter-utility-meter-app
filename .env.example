# 專櫃水電抄表自動化系統 - 環境變數設定範本
# 請將此檔案複製為 .env.local 或於 Google Apps Script 指令碼屬性中設定

# Google Gemini API 金鑰 (用於多模態影像辨識)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 副本試算表 ID (僅作為獨立調用備援，容器綁定專案預設自動取得)
SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# Google Drive 專屬資料夾 ID
FOLDER_PENDING_ID=YOUR_PENDING_FOLDER_ID    # 待處理水電表照片資料夾
FOLDER_ARCHIVED_ID=YOUR_ARCHIVED_FOLDER_ID  # 辨識合格歸檔資料夾
FOLDER_REVIEW_ID=YOUR_REVIEW_FOLDER_ID      # 異常待複查資料夾
